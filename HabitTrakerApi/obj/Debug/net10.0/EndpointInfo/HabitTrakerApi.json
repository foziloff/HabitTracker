            "nullable": true
          },
          "type": {
            "$ref": "#/components/schemas/HabitType"
          },
          "priority": {
            "$ref": "#/components/schemas/PriorityLevel"
          },
          "targetCount": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "CreateHabitLogDto": {
        "required": [
          "doneDate"
        ],
        "type": "object",
        "properties": {
          "doneDate": {
            "type": "string",
            "format": "date"
          },
          "value": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "note": {
            "maxLength": 500,
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CreateReminderDto": {
        "required": [
